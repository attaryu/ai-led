# ── Ollama endpoint ─────────────────────────────────────────
# Default: pakai Ollama di host lokal (uncomment kalau lokal):
# OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_TOKEN=

# Pakai remote Ollama (Vast.ai / runpod / dll), butuh token:
OLLAMA_HOST=http://<ip>:<port>
OLLAMA_TOKEN=***REDACTED***

# Model utk LLM-as-Judge (faithfulness, answer_relevancy, context_precision, context_recall)
JUDGE_MODEL=gpt-oss:20b

# Force CPU embedding (uncomment kalau tidak punya GPU / mau hemat VRAM):
# EMBEDDING_DEVICE=cpu

# Embedding model — default BAAI/bge-m3 (multilingual, 1024 dim, ~1.4 GB).
# Alternatif: firqaaa/indo-sentence-bert-base (110M, ringan tapi vocabulary terbatas)
# EMBEDDING_MODEL=BAAI/bge-m3

# ── LangSmith Tracing (optional) ────────────────────────────
# Dashboard visualisasi pipeline 6-stage RAG di smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=***REDACTED***
LANGCHAIN_PROJECT=led-generator
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Groq API (untuk eval RAGAS) ─────────────────────────────
GROQ_API_KEY=
