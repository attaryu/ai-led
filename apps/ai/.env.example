# LLM Provider: "ollama" atau "openrouter"
LLM_PROVIDER="openrouter"

# Ollama (Vast.ai atau lokal)
OLLAMA_BASE_URL="https://<vastai-instance-ip>:<port>"
OLLAMA_MODEL="deepseek-r1:7b"
OLLAMA_API_KEY="<optional-bearer-token>"
OLLAMA_TIMEOUT_SECONDS=300

# OpenRouter (aktif jika LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY="sk-or-v1-<your-key>"
OPENROUTER_MODEL="deepseek/deepseek-r1"

# RAGAS judge model — LLM yang menilai output assessment.
# Set agar BERBEDA dari assessment model untuk benchmarking yang fair.
# Kosongkan untuk fallback ke LLM_PROVIDER / OLLAMA_MODEL / OPENROUTER_MODEL.
RAGAS_PROVIDER="openrouter"
RAGAS_OPENROUTER_MODEL="anthropic/claude-haiku-4.5"
# RAGAS_OLLAMA_MODEL="qwen2.5:14b"
# RAGAS_OLLAMA_BASE_URL=""    # opsional: server Ollama berbeda
# RAGAS_OLLAMA_API_KEY=""

# Supabase — legacy, hanya dipakai db/migrate.py & db/verify_schema.py
# (alat CLI lama, tidak dipanggil dari live path manapun lagi)
SUPABASE_URL="https://<project-id>.supabase.co"
SUPABASE_SERVICE_KEY="<service-role-key>"

# Postgres monorepo (Prisma, packages/db) — dipakai db/postgres_client.py
# untuk assessment_sessions/indicator_results/reasoning_steps. Sama dengan
# DATABASE_URL di apps/backend/.env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/ai_led?schema=public"

# HuggingFace token untuk download embedding model lebih cepat (opsional)
# Dapatkan gratis di https://huggingface.co/settings/tokens (read-only token cukup)
HF_TOKEN="hf_<your-token>"

# App
MAX_PARALLEL_INDICATORS=5
CHROMA_PERSIST_DIR="/app/data/chroma_db"
RUBRIC_CACHE_DIR="/app/data/rubric_cache"
UPLOAD_DIR="/app/data/uploads"

# Redis — antrean BullMQ yang sama dipakai apps/backend (tracker baris 17)
REDIS_URL="redis://localhost:6379"
