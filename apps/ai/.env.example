# LLM Provider: "ollama", "openrouter", atau "huggingface"
LLM_PROVIDER="openrouter"

# Ollama (Vast.ai atau lokal)
# Bisa daftar beberapa endpoint dipisah koma — 1 alamat per GPU (masing-masing
# `ollama serve` dijalankan dengan CUDA_VISIBLE_DEVICES=N di port berbeda).
# Setiap panggilan (per indikator saat assessment, per eval run untuk RAGAS
# judge) round-robin memilih salah satu, jadi kerja paralel nyebar ke semua
# GPU alih-alih numpuk di 1. Satu alamat saja (tanpa koma) tetap jalan seperti
# biasa.
OLLAMA_BASE_URL="https://<vastai-instance-ip>:<port-gpu0>,https://<vastai-instance-ip>:<port-gpu1>,https://<vastai-instance-ip>:<port-gpu2>,https://<vastai-instance-ip>:<port-gpu3>"
# Bisa daftar beberapa model dipisah koma — yang pertama jadi default, semua
# jadi pilihan di dropdown model-select (GET /assessment/models, POST
# /assessment/start & /resume terima "model" opsional untuk override).
OLLAMA_MODEL="deepseek-r1:7b"
OLLAMA_API_KEY="<optional-bearer-token>"
OLLAMA_TIMEOUT_SECONDS=300

# Writing + assessment (AMI) memakai provider & model yang sama (OLLAMA_* atau OPENROUTER_*).
# Dengan LLM_PROVIDER=openrouter semua OLLAMA_* boleh dikosongkan.

# OpenRouter (aktif jika LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY="sk-or-v1-<your-key>"
# Sama seperti OLLAMA_MODEL — bisa daftar beberapa dipisah koma.
OPENROUTER_MODEL="deepseek/deepseek-v4-flash"

# RAGAS judge model — LLM yang menilai output assessment.
# Set agar BERBEDA dari assessment model untuk benchmarking yang fair.
# Kosongkan untuk fallback ke LLM_PROVIDER / OLLAMA_MODEL / OPENROUTER_MODEL.
# Bisa daftar beberapa model dipisah koma (dropdown model-select di halaman
# Evaluasi RAGAS: GET /eval/models, POST /eval/run terima "model" opsional).
RAGAS_PROVIDER="openrouter"
RAGAS_OPENROUTER_MODEL="google/gemini-3.5-flash"
# RAGAS_OLLAMA_MODEL="qwen2.5:14b"
# RAGAS_OLLAMA_BASE_URL=""    # opsional: server Ollama berbeda
# RAGAS_OLLAMA_API_KEY=""

# GENERASI_BAB judge model (SYSTEM_JUDGE — port dari led-wiriting(dimas)) —
# LLM TERPISAH dari penulis (dimas JUDGE_MODEL), supaya tidak menilai
# tulisannya sendiri. Ollama: default gpt-oss:20b (harus sudah di-pull di server).
# OpenRouter: default google/gemini-3.5-flash (dimas JUDGE_MODEL_GEMINI).
JUDGE_PROVIDER="openrouter"
JUDGE_OPENROUTER_MODEL="google/gemini-3.5-flash"
# JUDGE_OLLAMA_MODEL="gpt-oss:20b"

# LangSmith tracing (opsional) -- LangChain SDK otomatis mengaktifkan trace
# kalau var ini ada, tidak butuh perubahan kode apa pun.
# LANGCHAIN_TRACING_V2="true"
# LANGCHAIN_API_KEY="lsv2_pt_<your-key>"
# LANGCHAIN_PROJECT="led-generator"
# LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# Postgres monorepo (Prisma, packages/db) — dipakai db/postgres_client.py
# untuk assessment_sessions/indicator_results/reasoning_steps. Sama dengan
# DATABASE_URL di apps/backend/.env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/ai_led?schema=public"

# HuggingFace token -- dipakai (1) download embedding model lebih cepat
# (opsional), dan (2) chat completion kalau LLM_PROVIDER=huggingface (lewat
# HF Inference Providers, endpoint OpenAI-compatible, llm/chat_model.py).
# Dapatkan gratis di https://huggingface.co/settings/tokens (read-only token cukup)
HF_TOKEN="hf_<your-token>"
# Aktif jika LLM_PROVIDER=huggingface. Ganti kalau model default belum/tidak
# lagi tersedia di HF Inference Providers -- cek https://huggingface.co/settings/inference-providers.
# HF_MODEL="Qwen/Qwen2.5-72B-Instruct"
# JUDGE_HF_MODEL="Qwen/Qwen2.5-72B-Instruct"

# App
ASSESSMENT_MAX_PARALLEL=5
UPLOAD_DIR="/app/data/uploads"

# Redis — antrean BullMQ yang sama dipakai apps/backend (tracker baris 17)
REDIS_URL="redis://localhost:6379"

# Cloudflare R2 — sama dengan R2_* di apps/backend/.env. Dipakai worker.py
# untuk mengunduh berkas BuktiDukung sebelum diekstrak/di-embed.
R2_ACCOUNT_ID="<account-id>"
R2_ACCESS_KEY_ID="<access-key-id>"
R2_SECRET_ACCESS_KEY="<secret-access-key>"
R2_BUCKET_NAME="ai-led-uploads"
