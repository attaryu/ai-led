PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/ai_led?schema=public"
# true to log every raw Prisma SQL query (noisy) -- off by default
PRISMA_LOG_QUERIES="false"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Origin allowed to call the API with credentials (apps/web dev server)
WEB_ORIGIN="http://localhost:5173"

REDIS_URL="redis://localhost:6379"

# apps/ai FastAPI service — used by the chat SSE proxy (POST bab/:id/chat)
AI_SERVICE_URL="http://localhost:8000"

# Cloudflare R2 (S3-compatible) — BuktiDukung file storage, presigned upload/download.
R2_ACCOUNT_ID="isi_dengan_account_id"
R2_ACCESS_KEY_ID="isi_dengan_access_key_id"
R2_SECRET_ACCESS_KEY="isi_dengan_secret_access_key"
R2_BUCKET_NAME="ai-led-uploads"
